# Copy this file to .env and fill in real values.
# .env is gitignored.

# Mongo Atlas connection string. Find it under "Connect → Drivers" in Atlas.
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ratemypeer?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ratemypeer?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# How long a login session lasts.
JWT_EXPIRES_IN=7d

# Port the API listens on. Vite dev server proxies /api to this port.
PORT=5000

# Allowed CORS origin in dev. Comma-separate multiple if needed.
CLIENT_ORIGIN=http://localhost:5173
